{
  "name": "brickwright-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for the Brickwright editor",
  "main": "main.cjs",
  "author": "NHtoyo",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "node scripts/smoke-test.cjs",
    "prepare:assets": "node scripts/prepare-desktop-assets.cjs",
    "build:win": "electron-builder --win nsis --publish never",
    "build:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "sharp": "0.35.5"
  }
}
